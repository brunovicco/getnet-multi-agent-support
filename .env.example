APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=getnet-multi-agent-support
GETNET_CORPUS_PATH=data/getnet_knowledge.json

# Optional providers. The application remains functional without these values.
# Supported LLM provider: openai
# Verify the model identifier against the provider's current model list before deploying.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_BASE_URL=https://api.openai.com
LLM_TIMEOUT_SECONDS=20
# Opt-in: use the model as the primary router. Deterministic rules stay as the fallback.
LLM_ROUTER_ENABLED=false
LLM_ROUTER_TIMEOUT_SECONDS=2
# Supported web search provider: tavily
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.tavily.com
WEB_SEARCH_TIMEOUT_SECONDS=10

# Optional vendor-neutral OpenTelemetry traces (see README.md).
# Network-silent unless an endpoint is explicitly set. Requires `uv sync --extra observability`.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=getnet-multi-agent-support
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.version=0.1.0

# Optional Langfuse tracing (opt-in; see README.md).
# Leave unset to keep tracing disabled. Requires `uv sync --extra tracing`.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false
